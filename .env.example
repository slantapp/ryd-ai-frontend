# Copy to `.env.development` for local `npm run dev`, or `.env` / `.env.local` as needed.
# Vite only exposes vars prefixed with VITE_.

# Local learning API (ryd-learning-api-v2). Default local API port is 4000 to avoid
# clashing with this app’s Vite port (3000).
VITE_API_URL=http://localhost:4000

# Optional: Deepgram TTS for avatar / instructor speech
# VITE_DEEPGRAM_API_KEY=

# Optional: Judge0 code execution
# VITE_JUDGE0_API_URL=
