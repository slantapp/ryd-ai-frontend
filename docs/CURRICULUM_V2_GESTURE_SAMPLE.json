                "advance": "manual"
              },
              {
                "id": "q1",
                "type": "question",
                "phase": "assess",
                "advance": "on_answer",
                "avatar": {
                  "on_ask": "Quick check. Are gestures required in every beat?",
                  "gesture": "guidedQuestionSequence",
                  "on_correct": "Correct! Gestures are optional.",
                  "on_wrong": "Remember — you can leave gestures out.",
                  "gesture_on_correct": "celebrateSequence",
                  "gesture_on_wrong": "gentleCorrectionSequence"
                },
                "question": {
                  "id": "q1_tf",
                  "type": "true_false",
                  "question": "Gestures are optional in a curriculum beat.",
                  "answer": true,
                  "explanation": "Yes. Omit gesture fields and the lesson still runs."
                }
              },
              {
                "id": "end",
                "type": "bridge",
                "phase": "reflect",
                "next": null,
                "avatar": {
                  "text": "Nice work testing gestures. You can close this preview whenever you like.",
                  "gesture": { "name": "goodbyeSequence", "blendMs": 850, "eyeContactMs": 1200 }
