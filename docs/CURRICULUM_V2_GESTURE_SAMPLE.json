            "flow": [
              {
                "id": "hook",
                "type": "speak",
                "phase": "hook",
                "avatar": {
                  "text": "Hello! Watch my hands — I can wave hello with a gesture.",
                  "gesture": "welcomeSequence"
                },
                "advance": "auto"
              },
              {
                "id": "teach",
                "type": "display",
                "phase": "teach",
                "title": "Optional gestures",
                "body": "Teachers may add a gesture on a beat.\n\nIf they skip it, the lesson still works with light automatic gestures.",
                "speak_body": false,
                "avatar": {
                  "text": "This tip is important. I will point so you notice it.",
